<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard UI</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50">
  <div id="root">
    <div class="min-h-screen bg-gray-50 hero">
      
      <div class="flex">

        <!-- Mobile Menu Button -->
        <button class="lg:hidden fixed top-4 left-4 z-50 p-2 bg-white rounded-lg shadow-md border border-gray-200">
          ☰
        </button>

        <!-- Sidebar -->
        <div class="hidden lg:block w-64 bg-white border-r border-gray-200 h-screen sticky top-0">
          <!-- Sidebar content -->
        </div>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-h-screen">

          <!-- Header -->
          <header class="bg-white shadow-sm border-b border-gray-100 px-6 py-4">
            <h1 class="text-lg font-semibold text-gray-800">Dashboard</h1>
          </header>

          <!-- Main -->
          <main class="flex-1 p-6 lg:ml-0 ml-0">

            <div class="w-full max-w-auto">
              <div class="space-y-8 py-8">

                <!-- Top Section -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-4 sm:space-y-0">
                  <h2 class="text-xl font-semibold text-gray-800">Welcome Back</h2>
                </div>

                <!-- Quick Actions Card -->
                <div class="px-4">
                  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

                    <div class="px-6 py-4 border-b border-gray-100 bg-gradient-to-r from-blue-50 to-purple-50">
                      <h2 class="text-lg font-semibold text-gray-900">Quick Actions</h2>
                      <p class="text-sm text-gray-600 mt-1">
                        Frequently used tasks and shortcuts
                      </p>
                    </div>

                    <div class="p-6">
                      <!-- Action Buttons -->
                      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

                        <button class="w-full flex items-center space-x-3 p-4 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition">
                          <span>⚡</span>
                          <span>Action 1</span>
                        </button>

                        <button class="w-full flex items-center space-x-3 p-4 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition">
                          <span>🚀</span>
                          <span>Action 2</span>
                        </button>

                        <button class="w-full flex items-center space-x-3 p-4 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition">
                          <span>📊</span>
                          <span>Action 3</span>
                        </button>

                      </div>
                    </div>

                  </div>
                </div>

                <!-- Another Card -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden px-6 py-4 mx-4">
                  <h3 class="text-md font-semibold text-gray-800">Additional Section</h3>
                </div>

              </div>
            </div>

          </main>

        </div>
      </div>
    </div>
  </div>
</body>
</html>
